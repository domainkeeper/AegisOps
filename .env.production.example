# Production Environment Configuration
# Copy to .env.production and fill in real values. Never commit .env.production.

# ===== Core Application =====
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Authentication (REQUIRED in Production) =====
# Must start with a secure random key (32+ hex chars). Generate with: openssl rand -hex 32
AEGISOPS_API_SECRET_KEY=generate_a_long_random_secret_key_here
# Strong password for the admin user
AEGISOPS_API_PASSWORD=change_this_secure_password_in_production
# Admin username (default: admin)
AEGISOPS_API_USERNAME=admin

# ===== Database =====
AEGISOPS_DATABASE_URL=database/aegisops.db
AEGISOPS_AUDIT_DB=database/audit.db

# ===== CORS =====
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ===== ArmorIQ Configuration (Required for governed mode) =====
# Real ArmorIQ API key starting with ak_live_, ak_test_, or ak_claw_
# Get from ArmorIQ dashboard: platform.armoriq.ai -> API Keys
ARMORIQ_API_KEY=ak_live_replace_with_your_real_key
ARMORIQ_ENV=production
USE_PRODUCTION=true

# Optional ArmorIQ endpoint overrides (for self-hosting)
IAP_ENDPOINT=
PROXY_ENDPOINT=
BACKEND_ENDPOINT=

# ===== ArmorIQ Agent Email Scopes =====
# Per-agent identity scopes for delegation binding
AEGISOPS_COMMANDER_EMAIL=commander@aegisops.local
AEGISOPS_LOG_AGENT_EMAIL=log_agent@aegisops.local
AEGISOPS_DIAGNOSIS_AGENT_EMAIL=diagnosis_agent@aegisops.local
AEGISOPS_REMEDIATION_AGENT_EMAIL=remediation_agent@aegisops.local

# ===== Gemini LLM (Optional - required for real model diagnoses) =====
# Get key from: https://aistudio.google.com/app/apikey
AEGISOPS_GEMINI_API_KEY=replace_with_your_gemini_api_key
AEGISOPS_LLM_MODEL=gemini-3.5-flash-lite
AEGISOPS_LLM_TIMEOUT=30
# Set to "test" to use deterministic fallback when no key is available
AEGISOPS_LLM_FALLBACK=test