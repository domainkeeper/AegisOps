# Production Environment Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=database/aegisops.db
AEGISOPS_AUDIT_DB=database/audit.db

# Authentication (Required in Production)
AEGISOPS_API_USERNAME=admin
AEGISOPS_API_PASSWORD=change_this_secure_password_in_production
AEGISOPS_API_SECRET_KEY=generate_a_long_random_secret_key_here

# ArmorIQ Configuration
ARMORIQ_API_KEY=ak_live_replace_with_your_real_key
ARMORIQ_ENV=production

# Gemini Configuration
AEGISOPS_GEMINI_API_KEY=replace_with_your_gemini_api_key
AEGISOPS_LLM_MODEL=gemini-3.5-flash-lite

# CORS
CORS_ORIGINS=http://localhost:3000
